# ─────────────────────────────────────────────────
# NexusGuard  —  Environment Configuration Template
# ─────────────────────────────────────────────────
# Copy this file to `.env` and fill in your values.
# All fields are OPTIONAL for --dry-run mode.

# ── LLM Provider (pick one) ──────────────────────
# NEAR AI Cloud (OpenAI-compatible)
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud.near.ai/v1
NEAR_AI_MODEL=fireworks::accounts/fireworks/models/qwen2p5-72b-instruct

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── NEAR Configuration ───────────────────────────
NEAR_ACCOUNT_ID=nexusguard.testnet
NEAR_NETWORK=testnet
NEAR_ESCROW_CONTRACT=escrow.nexusguard.testnet

# ── Cross-Chain (Base L2 USDC settlement) ────────
BASE_RPC_URL=https://mainnet.base.org
SETTLEMENT_ADDRESS=0x0000000000000000000000000000000000000000

# ── NEAR Intents 1Click API ──────────────────────
NEAR_INTENTS_API_URL=https://1click.chaindefuser.com/v0
